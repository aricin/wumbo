{
  "name": "wumbo-email",
  "version": "0.1.0",
  "private": true,
  "description": "Email delivery service for wumbo.",
  "scripts": {
    "build": "sam build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "db:generate": "drizzle-kit generate --config=drizzle.config.mjs",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:check": "drizzle-kit check --config=drizzle.config.mjs",
    "local:identity-user-registered": "sam local invoke IdentityUserRegisteredConsumerFunction"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.0.0",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.20.0",
    "svix": "^1.90.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "dotenv": "^16.0.0",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.25.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
