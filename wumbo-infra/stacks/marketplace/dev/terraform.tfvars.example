aws_region                = "us-west-2"
target_account_id         = "222222222222"
vpc_cidr                  = "10.20.0.0/16"
# The shared instance uses the default `postgres` master user and does not
# create a workload-level application DB at instance creation time.
db_identifier             = "wumbo-marketplace-dev-postgres"
db_parameter_group_family = "postgres16"
db_instance_class         = "db.t4g.micro"
db_engine_version         = "16"
jump_host_enabled         = true
jump_host_instance_type   = "t3.nano"
nat_gateway_enabled       = true
public_subnet_count       = 2
alert_email_addresses   = ["you@example.com"]

db_allocated_storage      = 20
db_max_allocated_storage  = 100
db_multi_az               = false
db_deletion_protection    = false
db_skip_final_snapshot    = true
db_apply_immediately      = true
ui_github_repository        = "replace-me/wumbo-ui"
# Optional: once you have a real HTTPS domain for the deployed UI, set these so
# the shared UI infrastructure can provision the HTTPS endpoint. The identity
# service deploy now owns the Cognito hosted-login callback/logout values.
# ui_domain_name      = "app-dev.example.com"
# ui_route53_zone_id  = "Z1234567890"
# ui_certificate_arn  = "arn:aws:acm:us-west-2:111111111111:certificate/..."

tags = {
  Owner = "replace-me"
}
