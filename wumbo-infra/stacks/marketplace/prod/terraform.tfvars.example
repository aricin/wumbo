aws_region                = "us-west-2"
target_account_id         = "333333333333"
vpc_cidr                  = "10.30.0.0/16"
db_identifier             = "wumbo-marketplace-prod-postgres"
db_name                   = "marketplace"
db_username               = "wumbo_marketplace"
db_parameter_group_family = "postgres16"
db_instance_class         = "db.t4g.small"
db_engine_version         = "16"
jump_host_enabled         = true
jump_host_instance_type   = "t3.nano"
nat_gateway_enabled       = true
public_subnet_count       = 2
alert_email_addresses   = ["you@example.com"]

db_allocated_storage      = 20
db_max_allocated_storage  = 100
db_multi_az               = false
db_deletion_protection    = true
db_skip_final_snapshot    = false
db_apply_immediately      = false
cognito_allow_self_signup   = true
cognito_deletion_protection = true
cognito_ui_domain_prefix    = "wumbo-identity-prod-auth"
cognito_ui_callback_urls    = ["https://app.example.com/api/auth/callback"]
cognito_ui_logout_urls      = ["https://app.example.com"]
ui_github_repository        = "replace-me/wumbo-ui"
ui_domain_name              = "app.example.com"
ui_route53_zone_id          = "Z1234567890"
# Set this after deploying wumbo-core and copying PostConfirmationFunctionArn.
# cognito_post_confirmation_lambda_arn = "arn:aws:lambda:us-west-2:333333333333:function:wumbo-core-prod-post-confirmation"

tags = {
  Owner = "replace-me"
}
